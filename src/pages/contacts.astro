---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contacto | Tesk Suministros">
  <main class="bg-[#050505] text-white antialiased selection:bg-[#ffcc00] selection:text-black font-archivo overflow-x-hidden relative">
    
    <!-- FONDO DECORATIVO ESTRUCTURAL -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute inset-0 opacity-[0.03]" 
            style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 100px 100px;">
      </div>
      <div class="hidden md:block absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[#ffcc00]/5 to-transparent opacity-30"></div>
      <div class="hidden md:block absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[#ffcc00]/5 to-transparent opacity-30"></div>
    </div>

    <header class="relative h-[50vh] md:h-[60vh] flex flex-col justify-center items-center text-center px-6">
      <div class="absolute inset-0 z-0">
        <img 
          src="https://images.unsplash.com/photo-1581094794329-c8112a89af12?q=80&w=2070&auto=format&fit=crop" 
          class="w-full h-full object-cover opacity-30 grayscale blur-[1px]"
          alt="Fondo Industrial Tesk"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505]/0 via-[#050505]/40 to-[#050505] z-10"></div>
      </div>

      <div class="relative z-20 animate-fade-in mt-10">
        <p class="text-[#ffcc00] font-black uppercase tracking-[0.4em] md:tracking-[0.5em] text-[9px] md:text-[10px] mb-4 drop-shadow-[0_0_10px_rgba(255,204,0,0.4)]">Guacara • Venezuela</p>
        <h1 class="text-5xl md:text-[115px] font-black uppercase italic leading-[0.9] md:leading-[0.85] tracking-tighter">
          TESK <br /> 
          <span class="text-[#ffcc00] not-italic drop-shadow-[0_0_40px_rgba(255,204,0,0.6)]">SUMINISTROS</span>
        </h1>
      </div>
    </header>

    <section class="max-w-6xl mx-auto px-6 pb-20 relative z-20">
      <!-- 1. TARJETAS DE INFORMACIÓN -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 -mt-8 md:-mt-14 mb-12">
        <div class="group bg-[#0a0a0a]/90 backdrop-blur-md border border-[#ffcc00]/10 p-8 rounded-2xl transition-all duration-500 hover:border-[#ffcc00]/40 shadow-[0_0_30px_rgba(0,0,0,0.5)]">
          <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-[#ffcc00]/5 mb-6 group-hover:bg-[#ffcc00]/20 transition-all">
            <Icon name="lucide:map-pin" class="text-[#ffcc00]" size={24} />
          </div>
          <h3 class="text-white/20 font-black text-[9px] uppercase tracking-[0.4em] mb-2">Ubicación</h3>
          <p class="text-3xl font-black italic uppercase tracking-tighter mb-1 text-white">Guacara</p>
          <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Carabobo, Venezuela.</p>
        </div>

        <div class="group bg-[#0a0a0a]/90 backdrop-blur-md border border-[#ffcc00]/10 p-8 rounded-2xl transition-all duration-500 hover:border-[#ffcc00]/40 shadow-[0_0_30px_rgba(0,0,0,0.5)]">
          <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-[#ffcc00]/5 mb-6 group-hover:bg-[#ffcc00]/20 transition-all">
            <Icon name="lucide:phone" class="text-[#ffcc00]" size={24} />
          </div>
          <h3 class="text-white/20 font-black text-[9px] uppercase tracking-[0.4em] mb-2">Líneas Directas</h3>
          <p class="text-2xl font-black tracking-tighter text-white group-hover:text-[#ffcc00] transition-colors">+58 245-5646129</p>
          <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-1">Atención al cliente</p>
        </div>

        <div class="group bg-[#0a0a0a]/90 backdrop-blur-md border border-[#ffcc00]/10 p-8 rounded-2xl transition-all duration-500 hover:border-[#ffcc00]/40 shadow-[0_0_30px_rgba(0,0,0,0.5)]">
          <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-[#ffcc00]/5 mb-6 group-hover:bg-[#ffcc00]/20 transition-all">
            <Icon name="lucide:clock" class="text-[#ffcc00]" size={24} />
          </div>
          <h3 class="text-white/20 font-black text-[9px] uppercase tracking-[0.4em] mb-2">Atención</h3>
          <p class="text-3xl font-black italic uppercase tracking-tighter mb-1 text-white">Lun — Sáb</p>
          <p class="text-sm font-bold text-[#ffcc00]/80 tracking-tight">09:00 AM — 06:00 PM</p>
        </div>
      </div>

      <!-- 2. BOTONES RRSS (PRIORIDAD ALTA) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl mx-auto mb-16">
        <!-- WHATSAPP -->
        <a href="https://wa.me/582455646129" target="_blank" 
           class="group relative flex items-center justify-center gap-5 bg-[#25D366] text-white py-8 px-6 rounded-2xl overflow-hidden transition-all duration-500 hover:scale-[1.04] active:scale-95 shadow-[0_0_40px_rgba(37,211,102,0.4)]">
          <Icon name="simple-icons:whatsapp" class="w-10 h-10 relative z-10 filter drop-shadow-md" />
          <div class="flex flex-col relative z-10 text-left">
            <span class="text-[9px] font-black uppercase tracking-[0.3em] mb-1 text-white/90">Canal de ventas</span>
            <span class="text-3xl font-black uppercase italic leading-none tracking-tighter">WhatsApp</span>
          </div>
          <div class="absolute top-0 -inset-full h-full w-1/2 z-20 block transform -skew-x-12 bg-gradient-to-r from-transparent via-white/40 to-transparent group-hover:animate-shine"></div>
        </a>

        <!-- INSTAGRAM -->
        <a href="https://www.instagram.com/tesksuministros" target="_blank" 
           class="group relative flex items-center justify-center gap-5 bg-gradient-to-br from-[#f09433] via-[#e6683c] to-[#bc1888] text-white py-8 px-6 rounded-2xl overflow-hidden transition-all duration-500 hover:scale-[1.04] active:scale-95 shadow-[0_0_40px_rgba(230,104,60,0.4)]">
          <Icon name="simple-icons:instagram" class="w-10 h-10 relative z-10 filter drop-shadow-md" />
          <div class="flex flex-col relative z-10 text-left">
            <span class="text-[9px] font-black uppercase tracking-[0.3em] mb-1 text-white/90">Catálogo oficial</span>
            <span class="text-3xl font-black uppercase italic leading-none tracking-tighter">Instagram</span>
          </div>
          <div class="absolute top-0 -inset-full h-full w-1/2 z-20 block transform -skew-x-12 bg-gradient-to-r from-transparent via-white/40 to-transparent group-hover:animate-shine"></div>
        </a>
      </div>

      <!-- 3. ACCESO A MARCAS (MÁS ABAJO Y ESTÉTICO) -->
      <div class="flex flex-col items-center group">
        <a href="/marcas" class="flex items-center gap-6 px-10 py-4 rounded-xl border border-white/10 bg-[#0a0a0a] hover:bg-[#111] hover:border-[#ffcc00]/50 transition-all duration-500 shadow-xl">
           <Icon name="lucide:shield-check" class="w-6 h-6 text-[#ffcc00]" />
           <div class="flex flex-col">
             <span class="text-[11px] font-black uppercase italic tracking-tighter leading-tight text-white group-hover:text-[#ffcc00] transition-colors">Explorar Nuestras</span>
             <span class="text-[9px] font-bold uppercase tracking-[0.4em] text-white/30 leading-none">Marcas Aliadas</span>
           </div>
           <Icon name="lucide:chevron-right" class="w-5 h-5 text-white/20 group-hover:text-[#ffcc00] group-hover:translate-x-1 transition-all" />
        </a>
      </div>

    </section>

    <footer class="py-10 text-center text-[9px] text-gray-800 font-black uppercase tracking-[0.4em] md:tracking-[0.6em] border-t border-white/5 relative z-20 bg-[#050505]">
      Suministros Tesk © 2026 • Valencia, Carabobo
    </footer>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap');
  .font-archivo { font-family: 'Archivo Black', sans-serif; }
  @keyframes fade-in { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes shine { from { left: -100%; } to { left: 200%; } }
  .animate-fade-in { animation: fade-in 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .group-hover\:animate-shine { animation: shine 1.1s ease-in-out forwards; }
</style>