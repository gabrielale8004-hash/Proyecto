---
import Layout from '../layouts/Layout.astro';

const fondoImagen = "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?q=80&w=2070&auto=format&fit=crop";

const rutaPdf = "/productos/CATALOGO_TESK.pdf";
const nombreDescarga = "Catalogo_Tesk_2026.pdf";
---

<Layout title="Descarga de Catálogo | Suministros Tesk">
  <main class="relative min-h-screen flex items-center justify-center bg-black overflow-x-hidden selection:bg-[#FFD700] selection:text-black">
    
    <div class="absolute inset-0 z-0">
      <img 
        src={fondoImagen} 
        class="w-full h-full object-cover opacity-60 animate-subtle-zoom" 
        alt="Industrial Workshop"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_transparent_0%,_rgba(0,0,0,0.8)_100%)]"></div>
      <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <section class="relative z-10 w-full max-w-5xl px-4 md:px-6 py-20 flex flex-col items-center">
      
      <div class="mb-6 animate-fade-in">
        <span class="px-4 py-1.5 rounded-full border border-[#FFD700]/40 bg-[#FFD700]/10 text-[#FFD700] text-[9px] md:text-[10px] font-black uppercase tracking-[0.4em] shadow-[0_0_20px_rgba(255,215,0,0.2)]">
          Versión Digital 2026
        </span>
      </div>

      <div class="text-center mb-10 md:mb-14 animate-reveal-up">
        <h1 class="text-4xl sm:text-6xl md:text-8xl font-black text-white tracking-tighter uppercase italic leading-[0.9] md:leading-[0.85]">
          DESCARGAR <br/> 
          <span class="text-[#FFD700] drop-shadow-[0_0_30px_rgba(255,215,0,0.4)]">
            CATÁLOGO COMPLETO
          </span>
        </h1>
      </div>

      <div class="relative w-full max-w-4xl animate-reveal-up-delayed">
        <div class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-[#FFD700]/30 to-transparent rounded-[2rem] md:rounded-[3rem]"></div>
        
        <div class="relative backdrop-blur-xl bg-black/40 border border-white/10 rounded-[2rem] md:rounded-[3rem] p-8 md:p-16 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12 shadow-2xl">
          
          <div class="text-center md:text-left space-y-2">
            <h3 class="text-white font-black text-xl md:text-3xl uppercase italic tracking-tight leading-none">ESPECIFICACIONES <br/> TÉCNICAS</h3>
            <div class="flex items-center justify-center md:justify-start gap-4 pt-2">
                <span class="text-[#FFD700] font-mono text-[10px] md:text-xs font-bold uppercase tracking-widest">PDF</span>
                <span class="w-1.5 h-1.5 rounded-full bg-white/20"></span>
                <span class="text-white/60 font-mono text-[10px] md:text-xs uppercase tracking-widest">48.5 MB</span>
            </div>
          </div>

          <a 
            href={rutaPdf}
            download={nombreDescarga}
            class="w-full md:w-auto group relative flex items-center justify-center gap-6 md:gap-8 bg-[#FFD700] hover:bg-white text-black font-black py-5 md:py-7 px-8 md:px-14 rounded-xl md:rounded-2xl transition-all duration-500 shadow-[0_20px_50px_-10px_rgba(255,215,0,0.5)] active:scale-95"
          >
            <span class="text-lg md:text-2xl uppercase tracking-tighter">DESCARGAR AHORA</span>
            <div class="bg-black text-white p-2 md:p-3 rounded-lg md:rounded-xl group-hover:scale-110 transition-transform duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-6 md:h-6">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </div>
          </a>
        </div>
      </div>

    </section>
  </main>
</Layout>

<style>
  .animate-subtle-zoom {
    animation: subtle-zoom 20s infinite alternate;
    will-change: transform;
  }
  
  @keyframes subtle-zoom {
    from { transform: scale(1); }
    to { transform: scale(1.1); }
  }

  .animate-reveal-up {
    animation: reveal-up 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  .animate-reveal-up-delayed {
    opacity: 0;
    animation: reveal-up 0.8s cubic-bezier(0.23, 1, 0.32, 1) 0.3s forwards;
  }

  @keyframes reveal-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  h1, h3 {
    content-visibility: auto;
  }
</style>