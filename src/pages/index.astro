---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const servicios = [
  { 
    icon: "lucide:award", 
    title: "Resistencia", 
    desc: "Tornillería certificada bajo normas internacionales de calidad superior.",
    href: "/servicios/calidad",
    bg: "https://images.pexels.com/photos/3826678/pexels-photo-3826678.jpeg?auto=compress&cs=tinysrgb&w=800"
  },
  { 
    icon: "lucide:truck", 
    title: "Despacho", 
    desc: "Logística optimizada para entregas justo a tiempo en toda la región.",
    href: "/servicios/logistica",
    bg: "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=800&auto=format&fit=crop"
  },
  { 
    icon: "lucide:settings-2", 
    title: "Soporte", 
    desc: "Asesoría técnica especializada para la selección exacta de medidas.",
    href: "/servicios/asesoria",
    bg: "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=800&auto=format&fit=crop"
  }
];
---

<Layout title="Suministros Tesk | Potencia Industrial">
  <main class="bg-[#050505] antialiased">
    
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-start pt-24 md:pt-32 lg:pt-40 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#050505]/60 to-[#050505] z-20"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/20 to-transparent z-20"></div>
        
        <!-- MEJORA 1: Prioridad de carga para el Hero (LCP) -->
        <img 
          src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&q=80" 
          class="w-full h-full object-cover grayscale opacity-35 scale-110 object-right"
          alt="Suministros Tesk"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="container mx-auto px-6 relative z-30">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-3 px-4 py-2 bg-black/60 border border-white/10 rounded-full backdrop-blur-md mb-8">
            <span class="w-2 h-2 rounded-full bg-[#ffcc00] shadow-[0_0_10px_#ffcc00]"></span>
            <p class="text-white/80 font-bold uppercase tracking-[0.2em] md:tracking-[0.3em] text-[8px] md:text-[9px]">Guacara • Carabobo • Venezuela</p>
          </div>

          <h1 class="text-5xl md:text-9xl font-black text-white leading-[0.9] md:leading-[0.8] uppercase mb-10 tracking-tighter italic">
            FUERZA EN <br />
            <span class="text-[#ffcc00] drop-shadow-[0_0_50px_rgba(255,204,0,0.4)]">CADA GIRO</span>
          </h1>

          <div class="flex flex-col sm:flex-row gap-6 md:gap-10 items-center">
            <a href="/products" class="w-full sm:w-auto text-center px-10 py-5 bg-[#ffcc00] text-black font-black uppercase text-[10px] md:text-xs tracking-[0.2em] transition-all hover:bg-white hover:scale-105 shadow-[0_20px_50px_rgba(255,204,0,0.2)] active:scale-95">
              Explorar Inventario →
            </a>
            <a href="#servicios" class="text-white/50 hover:text-white font-bold uppercase text-[9px] md:text-[10px] tracking-[0.4em] transition-all border-b border-white/10 hover:border-[#ffcc00] pb-1">
              Nuestros Servicios
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Servicios -->
    <section id="servicios" class="relative py-24 md:py-32 px-6 overflow-hidden bg-[#050505]">
      <div class="absolute inset-0 z-0 opacity-10" 
            style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 40px 40px;">
      </div>

      <div class="max-w-7xl mx-auto relative z-10">
        <div class="mb-20">
          <p class="text-[#ffcc00] font-black uppercase tracking-[0.6em] text-[10px] mb-4 flex items-center gap-2">
            <span class="w-8 h-[1px] bg-[#ffcc00]"></span> RESPALDO INDUSTRIAL
          </p>
          <h2 class="text-5xl md:text-8xl font-black text-white uppercase tracking-tighter leading-[0.9] overflow-visible">
            COMPROMISO <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#ffcc00] to-[#aa8800] italic inline-block py-2 pr-16 whitespace-nowrap">
              Y PRECISIÓN
            </span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {servicios.map((item) => (
            <div class="group relative">
              <div class="absolute -inset-1 bg-gradient-to-r from-[#ffcc00]/20 to-transparent rounded-[2rem] blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              
              <div class="relative p-10 bg-[#0a0a0a] border border-white/5 rounded-[2rem] overflow-hidden flex flex-col transition-all duration-500 group-hover:border-[#ffcc00]/30">
                
                <!-- MEJORA 2: Lazy loading para las imágenes que no se ven al inicio -->
                <div class="absolute inset-0 z-0">
                    <img 
                      src={item.bg} 
                      class="w-full h-full object-cover opacity-10 grayscale" 
                      alt="" 
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
                </div>

                <a href={item.href} class="absolute inset-0 z-30 cursor-pointer">
                  <span class="sr-only">Ver más sobre {item.title}</span>
                </a>

                <span class="absolute -right-4 -top-4 text-9xl font-black text-white/[0.02] italic pointer-events-none group-hover:text-[#ffcc00]/5 transition-colors">
                  {item.title.substring(0, 1)}
                </span>

                <div class="mb-10 relative z-10">
                  <div class="w-16 h-16 bg-white/5 border border-white/10 rounded-2xl flex items-center justify-center text-[#ffcc00] shadow-xl transition-transform group-hover:scale-110">
                    <Icon name={item.icon} class="w-8 h-8" />
                  </div>
                </div>

                <h3 class="text-2xl font-black text-white uppercase mb-4 tracking-tighter group-hover:text-[#ffcc00] transition-colors z-10">
                  {item.title}
                </h3>
                
                <p class="text-gray-500 text-sm leading-relaxed mb-12 flex-grow font-medium group-hover:text-gray-300 transition-colors z-10">
                  {item.desc}
                </p>

                <div class="relative z-10 inline-flex items-center gap-3 text-[#ffcc00] text-[10px] font-black uppercase tracking-[0.4em]">
                  <span class="relative">
                    SABER MÁS
                    <span class="absolute bottom-0 left-0 w-0 h-[1px] bg-[#ffcc00] group-hover:w-full transition-all duration-500"></span>
                  </span>
                  <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-2" />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  h1, h2, h3 {
    content-visibility: auto;
    contain-intrinsic-size: 1px 100px;
  }
</style>