---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Requisitos de Apertura | Tesk">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" font-display="swap"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" font-display="swap" />
  
  <style>
    @keyframes reveal {
      from { opacity: 0; transform: translateY(30px); filter: blur(15px); }
      to { opacity: 1; transform: translateY(0); filter: blur(0); }
    }

    .animate-reveal {
      animation: reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      opacity: 0;
    }

    .hero-title {
      line-height: 1.1; 
      letter-spacing: -0.05em;
    }

    .text-fix {
      display: inline-block;
      transform: translateZ(0);
      -webkit-font-smoothing: antialiased;
      padding-bottom: 0.15em;
      padding-right: 0.05em;
    }

    /* FIX DEFINITIVO PARA LOS NÚMEROS: Sin cortes y nítidos */
    .number-display {
      font-family: 'Inter', sans-serif;
      font-weight: 900;
      font-style: italic;
      color: transparent;
      /* Usamos una técnica que no corta los bordes */
      -webkit-text-stroke: 1px rgba(212, 175, 55, 0.3);
      paint-order: stroke fill;
      transition: all 0.5s ease;
    }

    .glass-card:hover .number-display {
      -webkit-text-stroke: 1px rgba(212, 175, 55, 1);
      filter: drop-shadow(0 0 8px rgba(212, 175, 55, 0.2));
    }

    .glass-card {
      background: linear-gradient(145deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0.005) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.04);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @media (min-width: 1024px) {
      .glass-card:hover {
        border-color: rgba(212,175,55,0.25);
        background: rgba(212,175,55,0.015);
        transform: translateY(-4px);
      }
    }
  </style>

  <div class="min-h-screen bg-[#020202] text-zinc-300 font-['Inter'] antialiased selection:bg-[#D4AF37]/30 relative overflow-x-hidden">
    
    <!-- FONDO OPTIMIZADO -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img 
        src="https://images.unsplash.com/photo-1518770660439-4636190af475?q=60&w=1920&auto=format&fit=crop" 
        alt="Background" 
        class="w-full h-full object-cover grayscale opacity-[0.04]"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(212,175,55,0.06),transparent)]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#020202] via-transparent to-[#020202]"></div>
    </div>

    <main class="relative z-10 max-w-[1300px] mx-auto px-6 pt-28 md:pt-40 pb-20">
      
      <!-- BOTÓN VOLVER -->
      <div class="absolute top-10 left-6 sm:left-8">
        <a href="/" class="group inline-flex items-center gap-3 bg-black/40 backdrop-blur-xl border border-white/5 p-1.5 pr-5 rounded-full hover:border-[#D4AF37]/50 transition-all duration-500 animate-reveal" style="animation-delay: 0.1s">
          <div class="w-9 h-9 rounded-full bg-zinc-900 group-hover:bg-[#D4AF37] flex items-center justify-center text-zinc-500 group-hover:text-black transition-all">
            <span class="material-symbols-outlined text-lg font-light">home</span>
          </div>
          <span class="text-[10px] font-bold text-white uppercase tracking-wider">Inicio</span>
        </a>
      </div>

      <!-- HEADER -->
      <header class="max-w-4xl mb-16 md:mb-24 animate-reveal" style="animation-delay: 0.3s">
        <div class="flex items-center gap-3 mb-8">
          <div class="h-[1px] w-10 bg-[#D4AF37] shadow-[0_0_10px_rgba(212,175,55,0.7)]"></div>
          <span class="text-[#D4AF37] text-[10px] font-black uppercase tracking-[0.6em]">Documentación Requerida</span>
        </div>
        <h1 class="hero-title text-5xl sm:text-7xl md:text-[100px] font-normal text-white">
          <span class="text-fix">Checklist de</span> <br/>
          <span class="font-black italic text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-zinc-600 text-fix">Apertura</span>
        </h1>
      </header>

      <!-- GRID DE REQUISITOS -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-reveal" style="animation-delay: 0.5s">
        
        <!-- ITEM 01 -->
        <div class="glass-card rounded-[2rem] p-10 flex flex-col justify-between group">
          <div>
            <div class="number-display text-7xl md:text-8xl mb-6 text-fix">01</div>
            <h3 class="text-white font-bold uppercase tracking-widest text-sm mb-4 text-fix">Registro Mercantil</h3>
            <p class="text-zinc-500 text-sm leading-relaxed font-light">Copia legible del acta constitutiva y todas sus modificaciones estatutarias actualizadas.</p>
          </div>
          <div class="mt-8 pt-6 border-t border-white/5">
            <span class="text-[9px] text-zinc-600 font-black uppercase tracking-widest">Formato: PDF Digital</span>
          </div>
        </div>

        <!-- ITEM 02 -->
        <div class="glass-card rounded-[2rem] p-10 flex flex-col justify-between group">
          <div>
            <div class="number-display text-7xl md:text-8xl mb-6 text-fix">02</div>
            <h3 class="text-white font-bold uppercase tracking-widest text-sm mb-4 text-fix">Identificación Fiscal</h3>
            <p class="text-zinc-500 text-sm leading-relaxed font-light">RIF vigente de la empresa y de los representantes legales autorizados en acta.</p>
          </div>
          <div class="mt-8 pt-6 border-t border-white/5">
            <span class="text-[9px] text-zinc-600 font-black uppercase tracking-widest">Documento: VIGENTE</span>
          </div>
        </div>

        <!-- ITEM 03 -->
        <div class="glass-card rounded-[2rem] p-10 flex flex-col justify-between group">
          <div>
            <div class="number-display text-7xl md:text-8xl mb-6 text-fix">03</div>
            <h3 class="text-white font-bold uppercase tracking-widest text-sm mb-4 text-fix">Identidad Directiva</h3>
            <p class="text-zinc-500 text-sm leading-relaxed font-light">Cédula de identidad o Pasaporte legible de los firmantes y accionistas principales.</p>
          </div>
          <div class="mt-8 pt-6 border-t border-white/5">
            <span class="text-[9px] text-zinc-600 font-black uppercase tracking-widest">Prioridad: OBLIGATORIO</span>
          </div>
        </div>

        <!-- ITEM 04 -->
        <div class="glass-card rounded-[2rem] p-10 flex flex-col justify-between group">
          <div>
            <div class="number-display text-7xl md:text-8xl mb-6 text-fix">04</div>
            <h3 class="text-white font-bold uppercase tracking-widest text-sm mb-4 text-fix">Balance General</h3>
            <p class="text-zinc-500 text-sm leading-relaxed font-light">Estado financiero de los últimos dos periodos fiscales, firmado por contador público.</p>
          </div>
          <div class="mt-8 pt-6 border-t border-white/5">
            <span class="text-[9px] text-zinc-600 font-black uppercase tracking-widest">Verificación: Auditoría</span>
          </div>
        </div>

        <!-- ITEM 05 -->
        <div class="glass-card rounded-[2rem] p-10 flex flex-col justify-between group">
          <div>
            <div class="number-display text-7xl md:text-8xl mb-6 text-fix">05</div>
            <h3 class="text-white font-bold uppercase tracking-widest text-sm mb-4 text-fix">Referencias Bancarias</h3>
            <p class="text-zinc-500 text-sm leading-relaxed font-light">Al menos dos referencias de instituciones financieras con antigüedad mayor a 6 meses.</p>
          </div>
          <div class="mt-8 pt-6 border-t border-white/5">
            <span class="text-[9px] text-zinc-600 font-black uppercase tracking-widest">Tipo: COMERCIAL / BANCARIA</span>
          </div>
        </div>

        <!-- CTA -->
        <a href="/credito" class="bg-[#D4AF37] rounded-[2rem] p-10 flex flex-col justify-center items-center text-center group shadow-[0_20px_50px_rgba(212,175,55,0.1)] hover:bg-white transition-all duration-700">
          <span class="material-symbols-outlined text-black text-5xl mb-6 group-hover:scale-110 transition-transform">verified_user</span>
          <h3 class="text-black font-black uppercase tracking-widest text-sm mb-2 text-fix">¿Todo listo?</h3>
          <p class="text-black/60 text-xs mb-8 font-bold text-fix">Inicia tu proceso ahora mismo con nuestro equipo comercial.</p>
          <div class="bg-black text-white px-8 py-3 rounded-full text-[10px] font-black uppercase tracking-widest hover:scale-105 transition-all text-fix">Empezar Registro</div>
        </a>

      </div>

    </main>

    <!-- FOOTER -->
    <footer class="relative z-10 max-w-[1300px] mx-auto px-6 py-12 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center gap-4 opacity-30 animate-reveal" style="animation-delay: 0.7s">
        <span class="text-[9px] font-black uppercase tracking-[0.5em] text-fix">Compliance Division © 2026</span>
        <span class="text-[9px] font-black uppercase tracking-[0.5em] text-fix">Tesk Suministros</span>
    </footer>
  </div>
</Layout>